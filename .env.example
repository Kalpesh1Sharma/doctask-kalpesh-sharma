# Matches docker-compose.yml.
DATABASE_URL=postgresql://task1:task1_dev_password@localhost:5432/task1
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10

APP_NAME=task1
ENVIRONMENT=development

# Docker Compose host ports. Compose overrides DATABASE_URL/SOURCE_ROOT/ARTIFACT_ROOT
# inside containers while leaving the local-development values above unchanged.
TASK1_API_PORT=8000
TASK1_UI_PORT=5173
TASK1_POSTGRES_PORT=5432

SOURCE_ROOT=var/sources
ARTIFACT_ROOT=var/artifacts

# Required for the production semantic workflow.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=60
GROQ_FACT_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_CONTRADICTION_MODEL=openai/gpt-oss-20b
GROQ_RULE_EVALUATION_MODEL=openai/gpt-oss-20b
GROQ_DOCUMENT_CLASSIFICATION_MODEL=openai/gpt-oss-20b

# Conservative free-tier protection. The transport also honors Groq's live
# retry-after / remaining-token / token-reset response headers.
GROQ_MAX_REQUESTS_PER_MINUTE=20
GROQ_MIN_REQUEST_INTERVAL_SECONDS=3.1
GROQ_RATE_LIMIT_RESERVE_TOKENS=512
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_MAX_RETRIES=4
GROQ_BACKOFF_BASE_SECONDS=1
GROQ_BACKOFF_MAX_SECONDS=30
GROQ_ESTIMATED_CHARS_PER_TOKEN=3.5

# Grounded semantic role classification samples a bounded amount of source text.
DOCUMENT_CLASSIFICATION_MAX_CHUNKS=8
DOCUMENT_CLASSIFICATION_MAX_CHARS_PER_CHUNK=1500

# Phase 6C watcher pacing. Each watch-enabled Pile stores its own watch_location.
WATCH_POLL_INTERVAL_SECONDS=1
WATCH_STABLE_AFTER_SECONDS=1
WATCH_RETRY_DELAY_SECONDS=5
WATCH_PILE_LIMIT=200

# Optional JSON pricing catalog. Leave empty to keep estimated provider cost NULL.
# GROQ_MODEL_PRICING={"openai/gpt-oss-20b":{"input_cost_per_million":"0.075","output_cost_per_million":"0.30"}}

# Legacy OpenAI adapter settings are optional and are not used by the default
# REST/MCP production wiring.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Phase 6C-2 pgvector analysis retrieval
ANALYSIS_RETRIEVAL_TOP_K=12
ANALYSIS_RETRIEVAL_QUERY="Material mortgage-document facts: parties, obligations, amounts, dates, terms, approvals, disclosures, settlement details, and compliance-relevant statements."
# Background Run worker
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_BATCH_SIZE=100
WORKER_MAX_ADVANCES_PER_RUN=8
